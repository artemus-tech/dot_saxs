    <AssemblyName>DotSaxs.Portal.Tests</AssemblyName>
    <RootNamespace>DotSaxs.Portal.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <ProjectReference Include="../Testing/Testing.csproj" />
  </ItemGroup>
</Project>
